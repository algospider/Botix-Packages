# Dockerfile for building Botix Ubuntu rootfs - LEAN version (~80-100 MB)
# Used by .github/workflows/build-rootfs.yml

FROM ubuntu:24.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install ONLY essential packages in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core build tools (needed for native modules)
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    libffi-dev \
    # Version control
    git \
    # Network/download
    curl \
    wget \
    ca-certificates \
    # Python (minimal - AI/ML focus)
    python3 \
    python3-pip \
    python3-venv \
    # Node.js (for agents/tools)
    nodejs \
    npm \
    # Essential utilities
    jq \
    unzip \
    tar \
    gzip \
    xz-utils \
    # Shell basics
    sudo \
    command-not-found \
    # Locale support
    locales \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # Remove docs/man to save space
    && rm -rf /usr/share/doc /usr/share/man /usr/share/locale/* \
    && find /usr/share -name '*.a' -delete 2>/dev/null || true

# Create non-root user (UID 1000 matches typical Android app)
# Remove existing ubuntu user if present (UID 1000 in base image)
RUN if id "ubuntu" &>/dev/null; then userdel -r ubuntu; fi \
    && useradd -m -u 1000 -s /bin/bash botix \
    && echo "botix ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/botix

# Set up locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Create working directory
WORKDIR /home/botix

# Default shell
SHELL ["/bin/bash", "-c"]